#!/usr/bin/env python3
"""Set one simple Codex top-level TOML value under the shared config lock."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

from codex_config_utils import (
    locked_config,
    read_config,
    set_top_level_value,
    validate_toml,
    write_atomic_validated,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("config", type=Path)
    parser.add_argument("key")
    parser.add_argument("value")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*", args.key):
        parser.error("key must be a simple top-level TOML key")

    try:
        with locked_config(args.config):
            original = read_config(args.config)
            validate_toml(original)
            updated = set_top_level_value(original, args.key, args.value)
            if updated != original:
                write_atomic_validated(args.config, updated)
        return 0
    except Exception as exc:
        print(f"Codex config value was left unchanged: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
