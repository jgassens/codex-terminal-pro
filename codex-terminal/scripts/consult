#!/usr/bin/python3
"""Ask a consultant CLI a question, read-only and unprivileged.

Codex is this add-on's principal agent. Claude Code and Kimi Code are
optional consultants the user may authenticate; this runs one of them for a
single question and prints its answer.

Isolation, in order of how much it is relied on:

  1. The consultant runs as uid/gid 65534. Everything in /config is
     root-owned mode 644/755, so the kernel grants read and refuses every
     write. This is the guarantee, and it does not depend on CLI behaviour.
  2. Credentials are copied into a throwaway home rather than shared, so a
     consultant cannot read another agent's login (all are 0600 root) and
     cannot rewrite the real credential store.
  3. The environment is an allowlist, so no provider API key, Supervisor
     token, or GitHub PAT reaches the consultant.
  4. The CLI's own read-only flags are asked for as well. They are the least
     load-bearing layer here, being model-level rather than kernel-level.
"""

from __future__ import annotations

import argparse
import ctypes
import json
import os
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

WORKSPACE = "/config"
UNPRIVILEGED_UID = 65534
UNPRIVILEGED_GID = 65534
PR_SET_NO_NEW_PRIVS = 38
MAX_CREDENTIAL_BYTES = 1024 * 1024
DEFAULT_TIMEOUT_SECONDS = 300
DEFAULT_AGENT = "claude"
SETTINGS_FILE = os.environ.get("CONSULT_SETTINGS_FILE", "/data/settings.json")

# Stripped from the consultant's environment no matter which one runs, so a
# consultant can never bill or impersonate through another provider's key.
BLOCKED_ENV = (
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "MOONSHOT_API_KEY",
    "KIMI_API_KEY",
    "SUPERVISOR_TOKEN",
    "GITHUB_PAT_TOKEN",
    "GH_TOKEN",
    "GITHUB_TOKEN",
)

PASSTHROUGH_ENV = ("TERM", "LANG", "LC_ALL", "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY",
                   "https_proxy", "http_proxy", "no_proxy")


def claude_args(prompt: str, model: str, effort: str) -> list[str]:
    # Deny-by-default permissions with only read tools offered, no MCP servers
    # started from settings, and no session files written for a one-shot.
    #
    # Note: --bare looks like the natural choice here and is not usable. It
    # skips the stored state that carries the login, so every consult fails
    # with "Not logged in" even when the CLI is signed in.
    args = [
        "claude", "-p", prompt,
        "--permission-mode", "dontAsk",
        "--allowedTools", "Read,Glob,Grep",
        "--strict-mcp-config",
        "--no-session-persistence",
    ]
    if model:
        args += ["--model", model]
    if effort:
        args += ["--effort", effort]
    return args


def kimi_args(prompt: str, model: str, effort: str) -> list[str]:
    # Plan mode is Kimi's read-only posture; the uid drop is what actually
    # enforces it. Kimi has no effort setting, so it is ignored here.
    args = ["kimi", "--plan", "-p", prompt]
    if model:
        args += ["--model", model]
    return args


def always_ready(home: Path) -> tuple[bool, str]:
    return True, ""


def kimi_ready(home: Path) -> tuple[bool, str]:
    """Kimi needs a provider and model, registered after the token is issued.

    That registration is a separate server call during sign-in, so a valid
    token can sit next to an empty config when it fails. Reporting such an
    install as ready sends people to a confusing runtime error instead.
    """
    try:
        with open(home / "config.toml", "rb") as handle:
            data = tomllib.load(handle)
    except (OSError, ValueError):
        return False, "signed in, but its configuration could not be read"
    if data.get("default_model") or data.get("models") or data.get("providers"):
        return True, ""
    return False, "signed in, but no model is configured yet - sign in again to finish setup"


CONSULTANTS = {
    "claude": {
        "label": "Claude Code",
        "binary": "claude",
        "home_env": "CLAUDE_CONFIG_DIR",
        "default_home": "/data/.claude",
        # .credentials.json alone is a token with no account attached: Claude
        # reports "Not logged in" without .claude.json, and settings.json
        # carries the update/ripgrep settings seeded at boot. First entry is
        # the one that proves a completed sign-in.
        "credential_files": (".credentials.json", ".claude.json", "settings.json"),
        "credential_dirs": (),
        "login_proof": ".credentials.json",
        "ready_check": always_ready,
        "extra_env": {"DISABLE_AUTOUPDATER": "1", "USE_BUILTIN_RIPGREP": "0"},
        "build_args": claude_args,
        "auth_helper": "claude-auth-helper",
        # Which knobs the UI should offer. Claude takes an effort level;
        # Kimi has no equivalent flag.
        "supports_model": True,
        "supports_effort": True,
        "effort_levels": ("low", "medium", "high", "xhigh", "max"),
        "model_hint": "opus, sonnet, or a full model id",
    },
    "kimi": {
        "label": "Kimi Code",
        "binary": "kimi",
        "home_env": "KIMI_CODE_HOME",
        "default_home": "/data/.kimi-code",
        # Verified against a signed-in account: the token lives in a
        # credentials/ directory rather than a single file, and config.toml
        # carries the provider and default_model the token is useless without.
        "credential_dirs": ("credentials",),
        "credential_files": ("config.toml", "device_id"),
        # config.toml exists before any sign-in, so the token itself is the
        # only honest proof.
        "login_proof": "credentials/*.json",
        "ready_check": kimi_ready,
        "extra_env": {},
        "build_args": kimi_args,
        "auth_helper": "kimi-auth-helper",
        "supports_model": True,
        "supports_effort": False,
        "effort_levels": (),
        "model_hint": "a model alias from your Kimi provider",
    },
}


def load_settings() -> dict:
    """Read the add-on settings written by the web UI. Absent is normal."""
    try:
        with open(SETTINGS_FILE, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def consultant_preferences(settings: dict, agent: str) -> tuple[str, str]:
    """Model and effort chosen for one consultant, blank when unset."""
    consultants = settings.get("consultants")
    entry = consultants.get(agent) if isinstance(consultants, dict) else None
    if not isinstance(entry, dict):
        return "", ""
    model = entry.get("model")
    effort = entry.get("effort")
    return (
        model.strip() if isinstance(model, str) else "",
        effort.strip() if isinstance(effort, str) else "",
    )


class ConsultError(RuntimeError):
    """Raised when a consult cannot be run as specified."""


def consultant_home(spec: dict) -> Path:
    return Path(os.environ.get(spec["home_env"], spec["default_home"]))


def is_configured(spec: dict) -> bool:
    if shutil.which(spec["binary"]) is None:
        return False
    home = consultant_home(spec)
    return any(path.is_file() for path in home.glob(spec["login_proof"]))


def copy_credential(source: Path, destination: Path) -> bool:
    """Copy one credential file without following symlinks, 0600, nobody-owned."""
    try:
        fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    except (FileNotFoundError, OSError):
        return False
    try:
        info = os.fstat(fd)
        if info.st_size > MAX_CREDENTIAL_BYTES:
            raise ConsultError(f"{source} is larger than expected for a credential file")
        payload = os.read(fd, MAX_CREDENTIAL_BYTES)
    finally:
        os.close(fd)

    out = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(out, payload)
        os.fchown(out, UNPRIVILEGED_UID, UNPRIVILEGED_GID)
    finally:
        os.close(out)
    return True


def set_no_new_privileges() -> None:
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number))


def drop_privileges() -> None:
    os.setgroups([])
    os.setgid(UNPRIVILEGED_GID)
    os.setuid(UNPRIVILEGED_UID)
    set_no_new_privileges()


def build_environment(spec: dict, sandbox_home: Path) -> dict:
    env = {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": str(sandbox_home),
        "TMPDIR": str(sandbox_home),
        "NO_COLOR": "1",
        # The consultant's home points at the throwaway copy, so a refreshed
        # token is written there and discarded rather than into the real store.
        spec["home_env"]: str(sandbox_home),
    }
    for name in PASSTHROUGH_ENV:
        value = os.environ.get(name)
        if value:
            env[name] = value
    env.update(spec["extra_env"])
    for name in BLOCKED_ENV:
        env.pop(name, None)
    return env


def run_consult(agent: str, prompt: str, timeout: int, model: str = "", effort: str = "") -> int:
    spec = CONSULTANTS[agent]
    if effort and not spec["supports_effort"]:
        effort = ""
    if effort and effort not in spec["effort_levels"]:
        raise ConsultError(
            f"{spec['label']} effort must be one of: {', '.join(spec['effort_levels'])}"
        )
    if shutil.which(spec["binary"]) is None:
        raise ConsultError(f"{spec['label']} is not installed in this add-on")

    home = consultant_home(spec)
    if is_configured(spec):
        ready, note = spec["ready_check"](home)
        if not ready:
            raise ConsultError(f"{spec['label']} is {note}")
    if not is_configured(spec):
        raise ConsultError(
            f"{spec['label']} is not set up yet. Run {spec['auth_helper']} in a "
            f"shell, or use the session picker's consultant setup entry, to sign in."
        )

    sandbox = Path(tempfile.mkdtemp(prefix="consult-"))
    try:
        os.chmod(sandbox, 0o700)
        os.chown(sandbox, UNPRIVILEGED_UID, UNPRIVILEGED_GID)
        for name in spec["credential_files"]:
            copy_credential(home / name, sandbox / name)
        for name in spec.get("credential_dirs", ()):
            source_dir = home / name
            if not source_dir.is_dir():
                continue
            target_dir = sandbox / name
            os.mkdir(target_dir, 0o700)
            os.chown(target_dir, UNPRIVILEGED_UID, UNPRIVILEGED_GID)
            for entry in sorted(source_dir.iterdir()):
                if entry.is_file():
                    copy_credential(entry, target_dir / entry.name)

        completed = subprocess.run(
            spec["build_args"](prompt, model, effort),
            cwd=WORKSPACE,
            env=build_environment(spec, sandbox),
            preexec_fn=drop_privileges,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        raise ConsultError(f"{spec['label']} did not answer within {timeout}s")
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)

    answer = (completed.stdout or "").strip()
    if answer:
        print(answer)
    if completed.returncode != 0 and not answer:
        detail = (completed.stderr or "").strip().splitlines()
        raise ConsultError(
            f"{spec['label']} exited {completed.returncode}"
            + (f": {detail[-1]}" if detail else "")
        )
    return 0


def status_records() -> list[dict]:
    settings = load_settings()
    records = []
    for agent, spec in CONSULTANTS.items():
        installed = shutil.which(spec["binary"]) is not None
        signed_in = installed and is_configured(spec)
        ready, note = spec["ready_check"](consultant_home(spec)) if signed_in else (False, "")
        model, effort = consultant_preferences(settings, agent)
        records.append({
            "id": agent,
            "label": spec["label"],
            "installed": installed,
            "signedIn": signed_in,
            "ready": signed_in and ready,
            "readyNote": note,
            "authHelper": spec["auth_helper"],
            "supportsModel": spec["supports_model"],
            "supportsEffort": spec["supports_effort"],
            "effortLevels": list(spec["effort_levels"]),
            "modelHint": spec["model_hint"],
            "model": model,
            "effort": effort,
        })
    return records


def print_status(as_json: bool) -> int:
    records = status_records()
    if as_json:
        print(json.dumps({"consultants": records}))
        return 0
    for record in records:
        if not record["installed"]:
            state = "not installed"
        elif record["ready"]:
            state = "ready"
        elif record["signedIn"]:
            state = record["readyNote"] or "signed in, but not usable"
        else:
            state = f"not signed in (run {record['authHelper']})"
        print(f"{record['id']:8} {record['label']:12} {state}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="consult",
        description="Ask a consultant CLI a question about this Home Assistant config.",
    )
    parser.add_argument("--agent", choices=sorted(CONSULTANTS), default=None,
                        help="which consultant to ask (default: from Settings)")
    parser.add_argument("--timeout", type=int, default=None,
                        help="seconds to wait for an answer (default: from Settings)")
    parser.add_argument("--model", default=None,
                        help="model to ask for (default: from Settings)")
    parser.add_argument("--effort", default=None,
                        help="reasoning effort, where the consultant supports it")
    parser.add_argument("--list", action="store_true",
                        help="show which consultants are installed and signed in")
    parser.add_argument("--json", action="store_true",
                        help="with --list, report status as JSON")
    parser.add_argument("question", nargs="*",
                        help="the question; omit to read it from stdin")
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    if args.list:
        return print_status(args.json)

    prompt = " ".join(args.question).strip() if args.question else sys.stdin.read().strip()
    if not prompt:
        raise ConsultError("No question given")

    settings = load_settings()
    agent = args.agent or settings.get("defaultConsultant") or DEFAULT_AGENT
    if agent not in CONSULTANTS:
        raise ConsultError(f"Unknown consultant: {agent}")

    timeout = args.timeout
    if timeout is None:
        stored = settings.get("consultTimeoutSeconds")
        timeout = stored if isinstance(stored, int) else DEFAULT_TIMEOUT_SECONDS
    if timeout <= 0:
        raise ConsultError("--timeout must be positive")

    stored_model, stored_effort = consultant_preferences(settings, agent)
    model = args.model if args.model is not None else stored_model
    effort = args.effort if args.effort is not None else stored_effort
    return run_consult(agent, prompt, timeout, model, effort)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except ConsultError as error:
        print(f"consult: {error}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
