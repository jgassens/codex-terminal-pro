#!/usr/bin/env python3
"""Disable irrelevant HeyGen plugins without corrupting user TOML."""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

from codex_config_utils import (
    iter_toml_lines,
    locked_config,
    read_config,
    validate_toml,
    write_atomic_validated,
)


PLUGIN_IDS = (
    "heygen@openai-curated-remote",
    "heygen@openai-curated",
    "heygen@openai-bundled",
    "heygen@openai-primary-runtime",
)
TABLE_RE = re.compile(r"^\s*\[(?P<name>[^\]]+)]\s*(?:#.*)?$")
ENABLED_RE = re.compile(
    r"^(?P<prefix>[ \t]*enabled[ \t]*=[ \t]*)(?:true|false)(?P<suffix>[ \t]*(?:#.*)?)(?P<nl>\r?\n?)$"
)


def table_name(line: str) -> str | None:
    match = TABLE_RE.match(line.rstrip("\r\n"))
    return match.group("name").strip() if match else None


def plugin_table_names(plugin_id: str) -> set[str]:
    return {f'plugins."{plugin_id}"', f"plugins.'{plugin_id}'"}


def dotted_plugin_pattern(plugin_id: str) -> str:
    double = re.escape(f'plugins."{plugin_id}"')
    single = re.escape(f"plugins.'{plugin_id}'")
    return rf"(?:{double}|{single})"


def replace_enabled(line: str, key_pattern: str = "enabled") -> tuple[str, bool]:
    match = re.match(
        rf"^(?P<prefix>[ \t]*{key_pattern}[ \t]*=[ \t]*)(?:true|false)(?P<suffix>[ \t]*(?:#.*)?)(?P<nl>\r?\n?)$",
        line,
    )
    if not match:
        return line, False
    return f'{match.group("prefix")}false{match.group("suffix")}{match.group("nl")}', True


def split_tables(text: str) -> list[list[str]]:
    blocks: list[list[str]] = []
    current: list[str] = []
    for line, structural in iter_toml_lines(text):
        if structural and table_name(line) is not None and current:
            blocks.append(current)
            current = []
        current.append(line)
    if current:
        blocks.append(current)
    return blocks


def disable_table(block: list[str]) -> list[str]:
    output: list[str] = []
    replaced = False
    for line, structural in iter_toml_lines("".join(block)):
        updated, matched = replace_enabled(line) if structural else (line, False)
        if matched and not replaced:
            output.append(updated)
            replaced = True
        else:
            output.append(line)
    if not replaced:
        newline = "\r\n" if output and output[0].endswith("\r\n") else "\n"
        output.insert(1, f"enabled = false{newline}")
    return output


def insert_before_first_table(text: str, additions: list[str]) -> str:
    if not additions:
        return text
    annotated_lines = list(iter_toml_lines(text))
    lines = [line for line, _structural in annotated_lines]
    index = next(
        (
            i
            for i, (line, structural) in enumerate(annotated_lines)
            if structural and table_name(line) is not None
        ),
        len(lines),
    )
    rendered = "".join(f"{line}\n" for line in additions)
    if index > 0 and lines[index - 1].strip():
        rendered += "\n"
    lines.insert(index, rendered)
    return "".join(lines)


def disable_heygen_plugins(text: str) -> str:
    dotted_present: set[str] = set()
    dotted_enabled: set[str] = set()
    lines: list[str] = []
    in_table = False
    for line, structural in iter_toml_lines(text):
        if structural and table_name(line) is not None:
            in_table = True
        updated = line
        if structural and not in_table:
            for plugin_id in PLUGIN_IDS:
                plugin = dotted_plugin_pattern(plugin_id)
                if re.match(rf"^[ \t]*{plugin}\.", updated):
                    dotted_present.add(plugin_id)
                updated, replaced = replace_enabled(updated, rf"{plugin}\.enabled")
                if replaced:
                    dotted_enabled.add(plugin_id)
                    break
        lines.append(updated)

    blocks = split_tables("".join(lines))
    explicit_present: set[str] = set()
    lookup = {name: plugin_id for plugin_id in PLUGIN_IDS for name in plugin_table_names(plugin_id)}
    output: list[str] = []
    for block in blocks:
        name = table_name(block[0]) if block else None
        if name in lookup:
            plugin_id = lookup[name]
            explicit_present.add(plugin_id)
            block = disable_table(block)
        output.extend(block)

    updated = "".join(output)
    updated = insert_before_first_table(
        updated,
        [
            f'plugins."{plugin_id}".enabled = false'
            for plugin_id in PLUGIN_IDS
            if plugin_id in dotted_present and plugin_id not in dotted_enabled
        ],
    )
    for plugin_id in PLUGIN_IDS:
        if plugin_id in explicit_present or plugin_id in dotted_present:
            continue
        if updated and not updated.endswith(("\n", "\r\n")):
            updated += "\n"
        if updated and not updated.endswith("\n\n"):
            updated += "\n"
        updated += f'[plugins."{plugin_id}"]\nenabled = false\n'
    return updated


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=Path)
    args = parser.parse_args()
    codex_home = Path(os.environ.get("CODEX_HOME", "/data/.codex"))
    if args.config is None and codex_home != Path("/data/.codex"):
        return 0
    config = args.config or codex_home / "config.toml"

    try:
        with locked_config(config):
            original = read_config(config)
            validate_toml(original)
            updated = disable_heygen_plugins(original)
            validate_toml(updated)
            if updated != original:
                write_atomic_validated(config, updated, expected_text=original)
        return 0
    except Exception as exc:
        print(f"HeyGen config was left unchanged: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
