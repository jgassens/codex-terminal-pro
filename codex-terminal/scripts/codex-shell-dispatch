#!/usr/bin/env python3
"""Send a human-prefixed command through Codex Terminal Pro shell dispatch."""

import json
import os
import shlex
import sys
import urllib.error
import urllib.request


def normalize_command(argv):
    if len(argv) == 1:
        # One argument is the frontend/profile's intentional raw command text.
        command = argv[0]
    elif argv:
        # Direct CLI callers pass an argv vector; reconstruct it without losing
        # spaces, JSON quotes, or literal shell metacharacters.
        command = shlex.join(argv)
    else:
        command = sys.stdin.read()

    command = command.strip()
    if command.startswith(",,"):
        command = command[2:].lstrip()
    return command


def main():
    command = normalize_command(sys.argv[1:])
    if not command:
        print("usage: codex-shell-dispatch <shell command>", file=sys.stderr)
        return 64

    port = os.environ.get("IMAGE_SERVICE_PORT", "7680")
    url = f"http://127.0.0.1:{port}/terminal-shell-command"
    body = json.dumps({"command": command}).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            result = json.load(response)
    except urllib.error.HTTPError as err:
        detail = err.read().decode("utf-8", errors="replace")
        print(f"codex-shell-dispatch: HTTP {err.code}: {detail}", file=sys.stderr)
        return 1
    except Exception as err:
        print(f"codex-shell-dispatch: {err}", file=sys.stderr)
        return 1

    output = result.get("output") or ""
    if output:
        print(output)

    if result.get("timedOut"):
        if result.get("terminated"):
            print(
                "codex-shell-dispatch: command timed out and was stopped.",
                file=sys.stderr,
            )
            return 124
        print(
            "codex-shell-dispatch: command timed out; shell state is uncertain.",
            file=sys.stderr,
        )
        return 1

    exit_code = result.get("exitCode")
    if isinstance(exit_code, int) and 0 <= exit_code <= 255:
        return exit_code
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
