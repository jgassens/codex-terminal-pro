#!/usr/bin/env python3
"""Send a human-prefixed command through Codex Terminal Pro shell dispatch."""

import http.client
import json
import os
import shlex
import socket
import stat
import sys
from pathlib import Path


SOCKET_PATH = Path(
    os.environ.get(
        "SHELL_DISPATCH_SOCKET_PATH",
        "/run/codex-terminal/shell-dispatch.sock",
    )
)


def validate_socket(path):
    info = Path(path).lstat()
    if (
        not stat.S_ISSOCK(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) & 0o077
    ):
        raise ValueError("internal dispatch socket is not private")


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, socket_path, timeout=60):
        super().__init__("localhost", timeout=timeout)
        self.socket_path = str(socket_path)

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.socket_path)


def normalize_command(argv):
    if len(argv) == 1:
        # One argument is the frontend/profile's intentional raw command text.
        command = argv[0]
    elif argv:
        # Direct CLI callers pass an argv vector; reconstruct it without losing
        # spaces, JSON quotes, or literal shell metacharacters.
        command = shlex.join(argv)
    else:
        command = sys.stdin.read()

    command = command.strip()
    if command.startswith(",,"):
        command = command[2:].lstrip()
    return command


def main():
    command = normalize_command(sys.argv[1:])
    if not command:
        print("usage: codex-shell-dispatch <shell command>", file=sys.stderr)
        return 64

    body = json.dumps({"command": command}).encode("utf-8")
    socket_path = Path(os.environ.get("SHELL_DISPATCH_SOCKET_PATH", SOCKET_PATH))
    connection = None
    try:
        validate_socket(socket_path)
        connection = UnixHTTPConnection(socket_path, timeout=60)
        connection.request(
            "POST",
            "/terminal-shell-command",
            body=body,
            headers={"Content-Type": "application/json"},
        )
        response = connection.getresponse()
        if response.status >= 400:
            detail = response.read().decode("utf-8", errors="replace")
            print(
                f"codex-shell-dispatch: HTTP {response.status}: {detail}",
                file=sys.stderr,
            )
            return 1
        result = json.load(response)
    except Exception as err:
        print(f"codex-shell-dispatch: {err}", file=sys.stderr)
        return 1
    finally:
        if connection is not None:
            connection.close()

    output = result.get("output") or ""
    if output:
        print(output)

    if result.get("timedOut"):
        if result.get("terminated"):
            print(
                "codex-shell-dispatch: command timed out and was stopped.",
                file=sys.stderr,
            )
            return 124
        print(
            "codex-shell-dispatch: command timed out; shell state is uncertain.",
            file=sys.stderr,
        )
        return 1

    exit_code = result.get("exitCode")
    if isinstance(exit_code, int) and 0 <= exit_code <= 255:
        return exit_code
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
