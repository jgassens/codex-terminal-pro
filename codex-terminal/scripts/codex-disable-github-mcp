#!/usr/bin/env python3
"""Disable only legacy PAT-backed GitHub MCP transports when no PAT exists."""

from __future__ import annotations

import argparse
import os
import re
from pathlib import Path

from codex_config_utils import (
    locked_config,
    read_config,
    validate_toml,
    write_atomic_validated,
)


PLUGIN_IDS = (
    "github@openai-curated-remote",
    "github@openai-curated",
    "github@openai-bundled",
    "github@openai-primary-runtime",
)
TABLE_RE = re.compile(r"^\s*\[(?P<name>[^\]]+)]\s*(?:#.*)?$")
ENABLED_RE = re.compile(
    r"^(?P<prefix>[ \t]*enabled[ \t]*=[ \t]*)[^#\r\n]*?(?P<suffix>[ \t]*(?:#.*)?)(?P<nl>\r?\n?)$"
)


def table_name(line: str) -> str | None:
    match = TABLE_RE.match(line.rstrip("\r\n"))
    return match.group("name").strip() if match else None


def plugin_parent_names(plugin_id: str) -> set[str]:
    return {f'plugins."{plugin_id}"', f"plugins.'{plugin_id}'"}


def plugin_mcp_names(plugin_id: str) -> set[str]:
    prefixes = plugin_parent_names(plugin_id)
    return {
        *(f"{prefix}.mcp_servers.github" for prefix in prefixes),
        *(f'{prefix}.mcp_servers."github"' for prefix in prefixes),
        *(f"{prefix}.mcp_servers.'github'" for prefix in prefixes),
    }


GLOBAL_GITHUB_NAMES = {
    "mcp_servers.github",
    'mcp_servers."github"',
    "mcp_servers.'github'",
}


def split_tables(text: str) -> list[list[str]]:
    blocks: list[list[str]] = []
    current: list[str] = []
    for line in text.splitlines(keepends=True):
        if table_name(line) is not None and current:
            blocks.append(current)
            current = []
        current.append(line)
    if current:
        blocks.append(current)
    return blocks


def disable_block(block: list[str]) -> list[str]:
    output: list[str] = []
    replaced = False
    for line in block:
        match = ENABLED_RE.match(line)
        if not replaced and match:
            output.append(f'{match.group("prefix")}false{match.group("suffix")}{match.group("nl")}')
            replaced = True
        else:
            output.append(line)
    if not replaced:
        insert_at = 1 if output else 0
        newline = "\r\n" if output and output[0].endswith("\r\n") else "\n"
        output.insert(insert_at, f"enabled = false{newline}")
    return output


def is_known_global_github_server(block: list[str]) -> bool:
    body = "".join(block)
    token_match = re.search(
        r"^\s*bearer_token_env_var\s*=\s*([\"'])GITHUB_PAT_TOKEN\1\s*(?:#.*)?$",
        body,
        flags=re.MULTILINE,
    )
    url_match = re.search(
        r"^\s*url\s*=\s*([\"'])(?P<url>[^\"']+)\1\s*(?:#.*)?$",
        body,
        flags=re.MULTILINE,
    )
    known_url = bool(
        url_match
        and url_match.group("url").rstrip("/") == "https://api.githubcopilot.com/mcp"
    )
    # Only the exact legacy PAT-backed transport is managed. A user-authored
    # server may legitimately use the same URL with different authentication.
    return bool(token_match and known_url)


def replace_boolean_assignment(line: str, key_pattern: str) -> tuple[str, bool]:
    match = re.match(
        rf"^(?P<prefix>[ \t]*{key_pattern}[ \t]*=[ \t]*)(?:true|false)(?P<suffix>[ \t]*(?:#.*)?)(?P<nl>\r?\n?)$",
        line,
    )
    if not match:
        return line, False
    return f'{match.group("prefix")}false{match.group("suffix")}{match.group("nl")}', True


def dotted_plugin_pattern(plugin_id: str) -> str:
    double = re.escape(f'plugins."{plugin_id}"')
    single = re.escape(f"plugins.'{plugin_id}'")
    return rf"(?:{double}|{single})"


def insert_before_first_table(text: str, additions: list[str]) -> str:
    if not additions:
        return text
    lines = text.splitlines(keepends=True)
    insertion = next((index for index, line in enumerate(lines) if table_name(line) is not None), len(lines))
    rendered = "".join(f"{line}\n" for line in additions)
    if insertion > 0 and lines[insertion - 1].strip():
        rendered += "\n"
    lines.insert(insertion, rendered)
    return "".join(lines)


def disable_legacy_github_mcp(text: str) -> str:
    # Handle valid top-level dotted assignments before block processing. These
    # implicitly declare tables, so appending an explicit table would corrupt
    # otherwise valid TOML.
    dotted_parents: set[str] = set()
    nested_present: set[str] = set()
    top_level_lines: list[str] = []
    in_table = False
    for line in text.splitlines(keepends=True):
        if table_name(line) is not None:
            in_table = True
        updated_line = line
        if not in_table:
            for plugin_id in PLUGIN_IDS:
                plugin = dotted_plugin_pattern(plugin_id)
                if re.match(rf"^[ \t]*{plugin}\.enabled[ \t]*=", updated_line):
                    dotted_parents.add(plugin_id)
                key = rf"{plugin}\.mcp_servers\.(?:github|\"github\"|'github')\.enabled"
                updated_line, replaced = replace_boolean_assignment(updated_line, key)
                if replaced:
                    dotted_parents.add(plugin_id)
                    nested_present.add(plugin_id)
                    break
        top_level_lines.append(updated_line)

    text = "".join(top_level_lines)
    blocks = split_tables(text)
    parents_present: set[str] = set(dotted_parents)
    output: list[str] = []

    parent_lookup = {
        name: plugin_id
        for plugin_id in PLUGIN_IDS
        for name in plugin_parent_names(plugin_id)
    }
    nested_lookup = {
        name: plugin_id
        for plugin_id in PLUGIN_IDS
        for name in plugin_mcp_names(plugin_id)
    }

    for block in blocks:
        name = table_name(block[0]) if block else None
        if name in parent_lookup:
            plugin_id = parent_lookup[name]
            parents_present.add(plugin_id)
            local_key = r"mcp_servers\.(?:github|\"github\"|'github')\.enabled"
            transformed = [block[0]]
            for line in block[1:]:
                line, replaced = replace_boolean_assignment(line, local_key)
                if replaced:
                    nested_present.add(plugin_id)
                transformed.append(line)
            block = transformed
        if name in nested_lookup:
            plugin_id = nested_lookup[name]
            nested_present.add(plugin_id)
            block = disable_block(block)
        elif name in GLOBAL_GITHUB_NAMES and is_known_global_github_server(block):
            block = disable_block(block)
        output.extend(block)

    updated = "".join(output)
    dotted_missing = [
        plugin_id
        for plugin_id in dotted_parents
        if plugin_id not in nested_present
    ]
    updated = insert_before_first_table(
        updated,
        [
            f'plugins."{plugin_id}".mcp_servers.github.enabled = false'
            for plugin_id in dotted_missing
        ],
    )
    nested_present.update(dotted_missing)
    missing_nested = [
        plugin_id
        for plugin_id in PLUGIN_IDS
        if plugin_id in parents_present and plugin_id not in nested_present
    ]
    for plugin_id in missing_nested:
        if updated and not updated.endswith(("\n", "\r\n")):
            updated += "\n"
        if updated and not updated.endswith("\n\n"):
            updated += "\n"
        updated += (
            f'# Codex Terminal Pro: legacy PAT-backed transport is opt-in.\n'
            f'[plugins."{plugin_id}".mcp_servers.github]\n'
            "enabled = false\n"
        )
    return updated


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--config",
        type=Path,
        default=Path(os.environ.get("CODEX_HOME", "/data/.codex")) / "config.toml",
    )
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()

    if os.environ.get("GITHUB_PAT_TOKEN", "").strip():
        return 0
    if not args.config.exists():
        return 0

    try:
        with locked_config(args.config):
            original = read_config(args.config)
            validate_toml(original)
            updated = disable_legacy_github_mcp(original)
            validate_toml(updated)
            if updated == original:
                return 0
            if args.check:
                return 1
            write_atomic_validated(args.config, updated)
            return 0
    except Exception as exc:
        print(f"GitHub MCP config was left unchanged: {exc}", file=os.sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
