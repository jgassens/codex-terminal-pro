#!/bin/bash

# User-friendly command for installing packages persistently
# Usage: persist-install python git vim

set -euo pipefail

PERSIST_ROOT="${PERSIST_ROOT:-/data/packages}"
PERSIST_BIN="$PERSIST_ROOT/bin"
PERSIST_PYTHON="$PERSIST_ROOT/python"
PERSIST_APK_MANIFEST="$PERSIST_ROOT/apk-packages.txt"
PERSIST_PIP_MANIFEST="$PERSIST_PYTHON/requirements.txt"
PERSIST_MANIFEST_UPDATER="${PERSIST_MANIFEST_UPDATER:-/opt/scripts/update-apk-manifest}"
PERSIST_PACKAGE_MANAGER="${PERSIST_PACKAGE_MANAGER:-/opt/scripts/persistent-packages.sh}"
PERSIST_SYSTEM_PYTHON="${PERSIST_SYSTEM_PYTHON:-python3}"

is_safe_package_name() {
    case "$1" in
        ''|-*|*[!A-Za-z0-9@._:+!=\>\<,\[\]~-]*)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

validate_package_args() {
    local package

    for package in "$@"; do
        if ! is_safe_package_name "$package"; then
            echo "❌ Invalid package name: $package"
            return 1
        fi
    done
}

show_help() {
    cat << EOF
🔧 Persistent Package Installer

Install packages that survive container restarts!

USAGE:
    persist-install <package1> [package2] [...]
    persist-install --python <package1> [package2] [...]
    persist-install --ha-cli               # Explain the bundled guarded CLI
    persist-install --list
    persist-install --help

EXAMPLES:
    persist-install git vim htop          # Install system packages
    persist-install --python requests pandas  # Install Python packages
    persist-install --ha-cli              # Show bundled HA CLI policy
    persist-install --list                # Show installed packages

NOTES:
    • Requested APK package names are stored under /data/packages
    • Complete packages and dependencies are reinstalled after image updates
    • Python packages installed to virtual environment
    • Home Assistant CLI is bundled and cannot be shadowed by this helper

QUICK START:
    1. persist-install python3 py3-pip    # Install Python (first time)
    2. ha --help                          # Use the bundled guarded HA CLI
    3. Reboot and enjoy! Packages will still be there!

EOF
}

list_packages() {
    echo "=== 📦 Persistent Packages ==="
    echo ""
    echo "📁 Location: $PERSIST_ROOT"
    echo ""

    echo "🔧 APK packages restored on startup:"
    if [ -s "$PERSIST_APK_MANIFEST" ]; then
        sed 's/^/  • /' "$PERSIST_APK_MANIFEST"
    else
        echo "  (none installed)"
    fi
    echo ""

    echo "🐍 Python Packages ($PERSIST_PYTHON/venv):"
    if [ -x "$PERSIST_PYTHON/venv/bin/python" ]; then
        "$PERSIST_PYTHON/venv/bin/python" -m pip list --format=columns | tail -n +3 | sed 's/^/  • /'
    else
        echo "  (virtual environment not created)"
        echo "  Run: persist-install python3 py3-pip"
    fi
    echo ""

    echo "💾 Total size:"
    du -sh "$PERSIST_ROOT" 2>/dev/null || echo "  0B"
}

install_system_packages() {
    local packages=("$@")

    validate_package_args "${packages[@]}" || return 1

    echo "📦 Installing system packages: ${packages[*]}"
    echo ""

    echo "⏳ Installing via APK..."
    if ! PERSIST_ROOT="$PERSIST_ROOT" \
         PERSIST_MANIFEST_UPDATER="$PERSIST_MANIFEST_UPDATER" \
         PERSIST_SYSTEM_PYTHON="$PERSIST_SYSTEM_PYTHON" \
         "$PERSIST_PACKAGE_MANAGER" install-apk "${packages[@]}"; then
        echo "❌ Failed to install packages"
        return 1
    fi

    echo ""
    echo "✅ System packages installed and recorded!"
    echo "💡 Complete packages and dependencies will be reinstalled after image updates"
}

install_python_packages() {
    local packages=("$@")

    validate_package_args "${packages[@]}" || return 1

    echo "🐍 Installing Python packages: ${packages[*]}"
    echo ""

    echo "⏳ Installing packages..."
    if ! PERSIST_ROOT="$PERSIST_ROOT" \
         PERSIST_MANIFEST_UPDATER="$PERSIST_MANIFEST_UPDATER" \
         PERSIST_SYSTEM_PYTHON="$PERSIST_SYSTEM_PYTHON" \
         "$PERSIST_PACKAGE_MANAGER" install-pip "${packages[@]}"; then
        echo "❌ Failed to install or persist Python packages"
        return 1
    fi

    echo ""
    echo "✅ Python packages installed!"
    echo "💡 Use 'source $PERSIST_PYTHON/venv/bin/activate' to activate venv"
}

install_ha_cli() {
    echo "ℹ️  Home Assistant CLI is bundled and protected by the Supervisor broker."
    echo "   A second persistent ha binary is intentionally not installed because it"
    echo "   could shadow the guarded command. Update it through an add-on release."
}

# Main execution
main() {
    # Check if running in the add-on
    if [ ! -d "/data" ]; then
        echo "❌ Error: /data directory not found"
        echo "This script must run inside the Codex Terminal Pro add-on"
        exit 1
    fi

    case "${1:-}" in
        --help|-h|help)
            show_help
            ;;
        --list|-l|list)
            list_packages
            ;;
        --python|-p|python)
            shift
            if [ $# -eq 0 ]; then
                echo "❌ Error: No packages specified"
                echo "Usage: persist-install --python <package1> [package2] ..."
                exit 1
            fi
            install_python_packages "$@"
            ;;
        --ha-cli|ha-cli|ha)
            install_ha_cli
            ;;
        "")
            show_help
            ;;
        *)
            install_system_packages "$@"
            ;;
    esac
}

if [ "${PERSIST_INSTALL_LIBRARY_ONLY:-false}" != "true" ]; then
    main "$@"
fi
