#!/usr/bin/env python3
"""Set one dotted-path value in a Claude Code JSON settings file under the shared config lock."""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

from codex_config_utils import locked_config, read_config

DIRECTORY = getattr(os, "O_DIRECTORY", 0)
NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


def write_atomic_json(path: Path, data: dict) -> None:
    text = json.dumps(data, indent=2, sort_keys=True) + "\n"
    json.loads(text)
    try:
        existing = path.lstat()
        if not stat.S_ISREG(existing.st_mode) or existing.st_nlink != 1:
            raise ValueError("Claude settings destination must be one regular file")
        mode = stat.S_IMODE(existing.st_mode)
    except FileNotFoundError:
        mode = 0o644

    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)


def set_dotted_value(data: dict, dotted_key: str, value: object) -> bool:
    parts = dotted_key.split(".")
    node = data
    for part in parts[:-1]:
        child = node.get(part)
        if not isinstance(child, dict):
            child = {}
            node[part] = child
        node = child
    if node.get(parts[-1]) == value and parts[-1] in node:
        return False
    node[parts[-1]] = value
    return True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("settings", type=Path)
    parser.add_argument("key")
    parser.add_argument("value", help="JSON-encoded value, e.g. '\"1\"' or 'true'")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*(\.[A-Za-z_][A-Za-z0-9_-]*)*", args.key):
        parser.error("key must be a dotted path of simple identifiers")

    try:
        value = json.loads(args.value)
    except json.JSONDecodeError as exc:
        parser.error(f"value must be valid JSON: {exc}")

    try:
        with locked_config(args.settings):
            original = read_config(args.settings)
            data = json.loads(original) if original.strip() else {}
            if not isinstance(data, dict):
                raise ValueError("Claude settings root must be a JSON object")
            if set_dotted_value(data, args.key, value):
                write_atomic_json(args.settings, data)
        return 0
    except Exception as exc:
        print(f"Claude settings value was left unchanged: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
